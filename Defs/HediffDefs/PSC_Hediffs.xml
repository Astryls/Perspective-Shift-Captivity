<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Physical restraints applied by captors. Slows movement and manipulation. -->
  <HediffDef>
    <defName>PSC_Shackled</defName>
    <label>shackled</label>
    <description>Bound at the wrists and ankles by the captors. Movement and hand work are severely limited until the restraints come off.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <defaultLabelColor>(0.75, 0.65, 0.4)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.45</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
